[Unit]
Description=PC Admin & Performance Tool - Web-Service Edition (port 3038)
After=network.target

[Service]
Type=simple
# EDIT these two paths for your install location and user:
WorkingDirectory=/opt/pcadmintool
ExecStart=/opt/pcadmintool/.venv/bin/python app.py
Restart=on-failure
User=pcadmintool

[Install]
WantedBy=multi-user.target

# ---- Install as a real systemd service (optional, Linux only) ----
#   sudo cp pcadmintool.service.template /etc/systemd/system/pcadmintool.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pcadmintool
#   sudo systemctl status pcadmintool
